# bfinance configuration.
#
# Copy this file to .env and edit as needed:
#     cp .env.example .env
#
# Every variable is optional: if unset (or blank), the script uses the
# default shown here, which is the value that used to be hardcoded.
# Values are read by config.py via os.getenv(); .env is loaded automatically.
#
# Naming: shared/account-level settings have no prefix. Script-specific
# settings are prefixed with the script they belong to:
#   MA_      -> ma_crossover_bot.py
#   RT_      -> ma_crossover_bot_rt.py
#   RT_TB_   -> ma_crossover_bot_rt_tb.py
#   BT_      -> backtest.py
#   BT_TB_   -> backtest_tb.py
#   BT_CT_   -> backtest_CT_loop.py
#   BT_CT_TB_-> backtest_CT_loop_tb.py

# =============================================================================
# Credentials (required)
# =============================================================================
# Binance API key/secret. Required by every script; these are secrets and
# must never be committed (only .env.example is tracked, not .env).
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# =============================================================================
# Shared / account-level
# =============================================================================
# Trading mode. true = simulate orders only (paper), false = real orders.
PAPER_TRADING=True
# Trading pair and its base/quote currencies.
SYMBOL=BTC/USDT
BASE_CURRENCY=BTC
QUOTE_CURRENCY=USDT
# Taker fee as a fraction (0.001 = 0.1%).
TAKER_FEE_PCT=0.001
# Simulated slippage as a fraction (0.0005 = 0.05%).
SLIPPAGE_PCT=0.0005
# Market type passed to the exchange.
MARKET_TYPE=spot
# How long (seconds) a fetched balance is cached before refreshing.
BALANCE_CACHE_REFRESH_SEC=30

# =============================================================================
# ma_crossover_bot.py  (MA_)
# =============================================================================
MA_CANDLE_TIMEFRAME=1s
MA_SHORT_WINDOW=10
MA_LONG_WINDOW=50
MA_POSITION_SIZE_PCT=0.05
MA_MAX_TRADE_USD=1000.0
MA_STOP_LOSS_PCT=0.01
# Main-loop interval in minutes (10/60 = 10 seconds).
MA_SCHEDULE_MINUTES=0.16666666666666666
# Quick backtest run at startup.
MA_DATA_LIMIT=5000
MA_TOP_COMBOS_TO_DISPLAY=10

# =============================================================================
# ma_crossover_bot_rt.py  (RT_)
# =============================================================================
RT_CANDLE_TIMEFRAME=2h
RT_SHORT_WINDOW=20
RT_LONG_WINDOW=95
RT_ADX_THRESHOLD=25
RT_POSITION_SIZE_PCT=0.15
RT_MAX_TRADE_USD=500.0
RT_TAKE_PROFIT_PCT=0.05
RT_TRAILING_STOP_PCT=0.03
RT_ADX_PERIOD=14
RT_RSI_PERIOD=14
RT_RSI_OVERBOUGHT=70
RT_RSI_OVERSOLD=30
# Candle poll interval in seconds.
RT_CANDLE_POLLER=120
RT_VOLUME_MA_PERIOD=20
RT_VOLUME_MULTIPLIER=1.2

# =============================================================================
# ma_crossover_bot_rt_tb.py  (RT_TB_)
# =============================================================================
RT_TB_CANDLE_TIMEFRAME=2h
RT_TB_SHORT_WINDOW=20
RT_TB_LONG_WINDOW=95
RT_TB_ADX_THRESHOLD=25
RT_TB_POSITION_SIZE_PCT=0.15
RT_TB_MAX_TRADE_USD=500.0
RT_TB_TAKE_PROFIT_PCT=0.05
RT_TB_TRAILING_STOP_PCT=0.03
RT_TB_ADX_PERIOD=14
RT_TB_RSI_PERIOD=14
RT_TB_RSI_OVERBOUGHT=70
RT_TB_RSI_OVERSOLD=30
RT_TB_CANDLE_POLLER=120
RT_TB_VOLUME_MA_PERIOD=20
RT_TB_VOLUME_MULTIPLIER=1.2
RT_TB_START_DATE=2024-01-01
# Leave blank to use today's date.
RT_TB_END_DATE=

# =============================================================================
# backtest.py  (BT_)
# =============================================================================
BT_CANDLE_TIMEFRAME=2h
BT_INIT_USDT=10000.0
BT_DATA_LIMIT=5000
BT_TOP_COMBOS_TO_DISPLAY=10
BT_POSITION_SIZE_PCT=0.15
BT_MAX_TRADE_USD=500.0
BT_TAKE_PROFIT_PCT=0.05
BT_TRAILING_STOP_PCT=0.03

# =============================================================================
# backtest_tb.py  (BT_TB_)
# =============================================================================
BT_TB_CANDLE_TIMEFRAME=1h
BT_TB_INIT_USDT=10000.0
BT_TB_START_DATE=2024-01-01
# Leave blank to use today's date.
BT_TB_END_DATE=
BT_TB_TOP_COMBOS_TO_DISPLAY=10
BT_TB_POSITION_SIZE_PCT=0.15
BT_TB_MAX_TRADE_USD=500.0
BT_TB_TAKE_PROFIT_PCT=0.05
BT_TB_TRAILING_STOP_PCT=0.03

# =============================================================================
# backtest_CT_loop.py  (BT_CT_)
# =============================================================================
BT_CT_CANDLE_TIMEFRAME=1h
BT_CT_INIT_USDT=10000.0
BT_CT_DATA_LIMIT=5000
BT_CT_TOP_COMBOS_TO_DISPLAY=10
BT_CT_POSITION_SIZE_PCT=0.15
BT_CT_MAX_TRADE_USD=500.0
BT_CT_TAKE_PROFIT_PCT=0.05
BT_CT_TRAILING_STOP_PCT=0.03

# =============================================================================
# backtest_CT_loop_tb.py  (BT_CT_TB_)
# =============================================================================
BT_CT_TB_CANDLE_TIMEFRAME=1h
BT_CT_TB_INIT_USDT=10000.0
BT_CT_TB_START_DATE=2025-10-01
# Leave blank to use today's date.
BT_CT_TB_END_DATE=
BT_CT_TB_TOP_COMBOS_TO_DISPLAY=10
BT_CT_TB_POSITION_SIZE_PCT=0.15
BT_CT_TB_MAX_TRADE_USD=500.0
BT_CT_TB_TAKE_PROFIT_PCT=0.05
BT_CT_TB_TRAILING_STOP_PCT=0.03
