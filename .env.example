# bfinance configuration template.
#
# Copy this file to .env and edit as needed:
#     cp .env.example .env
#
# Every value is optional except the two credentials: if unset (or blank),
# the code uses the default shown here (the value that used to be hardcoded),
# so a near-empty .env behaves exactly as before.
#
# This template covers only what the main bot needs:
#   ma_crossover_bot.py  (+ backtest.py, which it runs at startup)
# The extra scripts in scripts/ read additional optional variables; see
# scripts/README.md for the per-script list.

# =============================================================================
# Credentials (required)
# =============================================================================
# Binance API key/secret. Secrets belong only in .env, never in git.
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# =============================================================================
# Shared / account-level
# =============================================================================
# true = simulate orders only (paper). false = place real orders.
PAPER_TRADING=True
# Trading pair and its base/quote currencies.
SYMBOL=BTC/USDT
BASE_CURRENCY=BTC
QUOTE_CURRENCY=USDT
# Taker fee and simulated slippage, as fractions (0.001 = 0.1%).
TAKER_FEE_PCT=0.001
SLIPPAGE_PCT=0.0005
# How long (seconds) a fetched balance is cached before refreshing.
BALANCE_CACHE_REFRESH_SEC=30

# =============================================================================
# Shared backtest strategy (used by backtest.py at bot startup)
# =============================================================================
INIT_USDT=10000.0
POSITION_SIZE_PCT=0.15
MAX_TRADE_USD=500.0
TAKE_PROFIT_PCT=0.05
TRAILING_STOP_PCT=0.03
TOP_COMBOS_TO_DISPLAY=10

# =============================================================================
# ma_crossover_bot.py  (MA_)
# =============================================================================
MA_CANDLE_TIMEFRAME=1s
MA_SHORT_WINDOW=10
MA_LONG_WINDOW=50
MA_POSITION_SIZE_PCT=0.05
MA_MAX_TRADE_USD=1000.0
MA_STOP_LOSS_PCT=0.01
# Main-loop interval in minutes (10/60 = 10 seconds).
MA_SCHEDULE_MINUTES=0.16666666666666666
# Candle window for the startup backtest.
MA_DATA_LIMIT=5000
MA_TOP_COMBOS_TO_DISPLAY=10

# =============================================================================
# backtest.py  (BT_)
# =============================================================================
BT_CANDLE_TIMEFRAME=2h
BT_DATA_LIMIT=5000
